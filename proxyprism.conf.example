# ProxyPrism Linux CLI system configuration file.
# Place this file at /etc/proxyprism.conf or pass a custom path with:
#   sudo proxyprism --config /path/to/your.conf
#
# This file uses TOML syntax (https://toml.io). Proxy, rules, and logging are
# configured here and nowhere else. If you store proxy credentials here, set
# the file permissions to 600 (rw-------) after editing.

version = "1.0"

[proxy]
# Proxy URL format: type://host:port or type://host:port:username:password.
# IPv6 proxy endpoints use brackets, for example socks5://[::1]:1080.
# Supported types: socks5, http
url = "socks5://127.0.0.1:1080"

[options]
# Logging verbosity: 0 = silent, 1 = logs, 2 = connections, 3 = both.
verbose = 0

# Rules are evaluated in order and the first match wins. Use [[rules]] for each rule.
# Supported fields per rule:
#   process   - process name, wildcard (*), or multiple names separated by ';'
#   hosts     - *, IPv4/IPv6 literal, IPv4/IPv6 CIDR, IPv4 wildcard/range,
#               or multiple values separated by ';'. Hostnames are not supported.
#   ports     - port, port range, or multiple values separated by ';' or ','
#   protocol  - TCP, UDP, or BOTH
#   action    - PROXY, DIRECT, or BLOCK
#   enabled   - true/false (optional, default true)
#
# You may also use TOML arrays for process/hosts/ports, e.g.:
#   process = ["curl", "wget"]
#   hosts = ["2001:db8::/32", "192.0.2.*"]

[[rules]]
process = "curl"
hosts = "*"
ports = "*"
protocol = "TCP"
action = "PROXY"

[[rules]]
process = "firefox"
hosts = "*"
ports = "80;443"
protocol = "TCP"
action = "DIRECT"

[[rules]]
process = "*"
hosts = "*"
ports = "53"
protocol = "UDP"
action = "PROXY"

# Example: block a specific application.
# [[rules]]
# process = "malware"
# hosts = "*"
# ports = "*"
# protocol = "BOTH"
# action = "BLOCK"
# enabled = true

# Standard pattern: keep DNS direct while proxying everything else.
# Rules are matched in order, so the DNS rule MUST come before the catch-all.
# [[rules]]
# process = "*"
# hosts = "*"
# ports = "53"
# protocol = "BOTH"
# action = "DIRECT"
#
# [[rules]]
# process = "*"
# hosts = "*"
# ports = "*"
# protocol = "BOTH"
# action = "PROXY"
